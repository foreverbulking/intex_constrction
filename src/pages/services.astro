---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImage from '../assets/hero-scaffolding-envelope.png';
import interiorRenovation from '../assets/project-macneill-interior-renovation.jpg';
import frontierExterior from '../assets/project-frontier-collegiate-exterior.jpg';
import weldingShop from '../assets/project-frontier-collegiate-welding-shop.jpg';
import vestibuleDoor from '../assets/project-frontier-vestibule-door.jpg';
import parapetRooftop from '../assets/project-parapet-rooftop.jpg';

const title = 'Construction Services | Intext Construction Ltd. — Manitoba';
const description = 'Full-spectrum general contracting in Manitoba: interior renovations, building envelope, flooring & ceilings, doors & windows, parapet construction, and project management.';
---
<Base title={title} description={description}>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h1>Every Trade. One Contractor.</h1>
        <p class="lead">From building envelope to final finishes, Intext Construction manages the full scope of your project — residential, commercial, and industrial — with one point of contact from consult to handover.</p>
      </div>
    </div>
  </section>

  <section class="section section--tight section--surface section--border-top">
    <div class="container">
      <div class="grid-3">
        <div class="sector-card">
          <h3>Residential</h3>
          <p>Home renovations and additions, built with the same craftsmanship and accountability as our commercial work.</p>
        </div>
        <div class="sector-card">
          <h3>Commercial</h3>
          <p>Retail, restaurant, and office fit-outs completed on schedule, with minimal disruption to your business.</p>
        </div>
        <div class="sector-card">
          <h3>Industrial</h3>
          <p>Mechanical rooms, welding shops, and industrial interiors built to the standards your operation depends on.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--border-top" id="main-services">
    <div class="container">

      <div class="service-block" id="interior-renovations">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="14" height="6" rx="1"/><line x1="8" y1="10" x2="8" y2="15"/><rect x="6" y="15" width="4" height="5" rx="1"/></svg>
          </div>
          <h3>Interior Renovations</h3>
          <p>Full interior refreshes — flooring, walls, and ceilings — for offices, schools, and retail spaces that need to look new again without a ground-up rebuild.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Flooring replacement</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Wall &amp; ceiling finishing</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Fixture &amp; millwork installation</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={interiorRenovation} alt="Renovated office space with new desk and window" width={768} height={576} />
        </div>
      </div>

      <div class="service-block is-reversed" id="exterior-envelope">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18"/><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="10" y2="21"/></svg>
          </div>
          <h3>Exterior &amp; Building Envelope</h3>
          <p>Envelope repair and modification that keeps the elements out and the structure sound — including wall openings for new mechanical, electrical, or access requirements.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Building envelope repair</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Wall opening additions</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Weatherproofing &amp; flashing</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={frontierExterior} alt="Frontier Collegiate brick exterior with building signage" width={768} height={576} />
        </div>
      </div>

      <div class="service-block" id="flooring-walls-ceilings">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>
          </div>
          <h3>Flooring, Walls &amp; Ceilings</h3>
          <p>Precision finishing across every surface — the trade work that turns a shell of a room into a finished space, done right the first time.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Flooring systems</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Wall assemblies</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Ceiling systems</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={weldingShop} alt="Welding shop interior at Frontier Collegiate" width={768} height={576} />
        </div>
      </div>

      <div class="service-block is-reversed" id="doors-windows">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="1"/><circle cx="15" cy="12" r="1"/></svg>
          </div>
          <h3>Doors &amp; Windows</h3>
          <p>Replacement and renovation work that seals out the Manitoba weather — from single door swaps to full vestibule rebuilds.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Door replacement</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Vestibule renovation</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Window flashing replacement</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={vestibuleDoor} alt="Renovated entrance vestibule and replacement door" width={768} height={1024} />
        </div>
      </div>

      <div class="service-block" id="parapet-construction">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"/><path d="M5 20V10h3V7h2v3h4V6h2v4h3v10"/></svg>
          </div>
          <h3>Parapet Construction</h3>
          <p>Rooftop parapet and building-edge construction, built to code for long-term weather and structural performance.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Rooftop parapet construction</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Building-edge detailing</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Code-compliant assemblies</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={parapetRooftop} alt="Aerial view of rooftop HVAC and mechanical units during parapet construction" width={768} height={576} />
        </div>
      </div>

      <div class="service-block is-reversed" id="general-contracting">
        <div class="service-block-text">
          <div class="service-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="1"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M9 13l2 2 4-4"/></svg>
          </div>
          <h3>General Contracting &amp; Project Management</h3>
          <p>One point of contact for the entire build — scheduling trades, managing budget, and keeping you informed from consult to handover.</p>
          <ul class="service-block-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Single point of contact</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Scheduling &amp; trade coordination</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Budget management</li>
          </ul>
        </div>
        <div class="service-block-media">
          <Image src={heroImage} alt="Scaffolding and building envelope work on a glass-front commercial building" width={768} height={768} />
        </div>
      </div>

    </div>
  </section>

  <section class="section section--surface section--border-top">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">How It Works</span>
        <h2>From consult to handover</h2>
      </div>
      <div class="process-strip">
        <div class="process-step">
          <span class="num">01</span>
          <h3>Consult</h3>
          <p>We walk the site, discuss scope, and understand your goals.</p>
        </div>
        <div class="process-step">
          <span class="num">02</span>
          <h3>Quote</h3>
          <p>You receive a clear, itemized quote before any work begins.</p>
        </div>
        <div class="process-step">
          <span class="num">03</span>
          <h3>Build</h3>
          <p>Our crews execute the work with regular updates on progress.</p>
        </div>
        <div class="process-step">
          <span class="num">04</span>
          <h3>Handover</h3>
          <p>Final walkthrough, sign-off, and a completed project you can trust.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Have a project in mind?"
    lead="Tell us the scope and we'll put together a clear, itemized quote."
    primaryLabel="Get a Free Quote"
  />

</Base>
